module

public import PolyFun.Control.Monad.Ordered

/-!
# Dijkstra monads

A Dijkstra monad over a specification monad `w` is a family `d : w α → Type` of computations
indexed by their specifications, with a `pure` at `pure x` and a `bind` at `wa >>= wb`
(Maillard et al., *Dijkstra monads for all*, ICFP 2019).

## Main definitions

- `DijkstraMonad w d`, with notation `x >>=ᵈ f` for `dBind` and `f <$>ᵈ x` for `dMap`, and its
  laws `LawfulDijkstraMonad`, stated up to the monad laws of `w`.
- `OrderedDijkstraMonad`, a Dijkstra monad over an ordered specification monad with a weakening
  along the order (`dWeaken`).
- `DijkstraMonad.dDite` and `DijkstraMonad.dIte`, branching.
- `DijkstraMonadMorphism` and `LawfulDijkstraMonadLift`, maps of Dijkstra monads along a monad
  lift of their specifications.
- `DijkstraMonad.instOfMonadRelation`: a lawful monad relation between `m` and `n` presents a
  Dijkstra monad over `n` whose computations at `na` are the `m`-computations related to `na`;
  `DijkstraMonad.instOfMonadMorphism` is the case of the graph of a lawful lift.
- `DijkstraMonad.instMonadSigma`: a Dijkstra monad is a monad on the pairs of a specification
  and a computation, related to its specification monad by the first projection. In the paper
  this construction and `instOfMonadRelation` are adjoint; the adjunction is not stated here.
- `FreeDijkstra m`, the Dijkstra monad generated by the binds of `m`: its computations are
  `pure` and binds of a specification-level computation with a computation for each result.
  Over a lawful `m` it is a `DijkstraMonad` (`FreeDijkstra.instDijkstraMonad`), whose `dBind`
  transports specifications along `pure_bind` and `bind_assoc`; its laws are not stated here.
-/

@[expose] public section

universe u v w z

open scoped OrderedMonad

/-- A Dijkstra monad over the specification monad `w`: a type `d wa` of computations for each
specification `wa`, with `dPure` at `pure x` and `dBind` at `wa >>= wb`. -/
class DijkstraMonad (w : Type u → Type v) (d : {α : Type u} → w α → Type z) [Monad w] where
  /-- The computation returning `x`, specified by `pure x`. -/
  dPure {α : Type u} : (x : α) → d (pure x)
  /-- Sequencing, specified by the bind of the specifications. -/
  dBind {α β : Type u} {wa : w α} {wb : α → w β} : d wa → ((a : α) → d (wb a)) → d (wa >>= wb)

export DijkstraMonad (dPure dBind)

@[inherit_doc] infixl:55 " >>=ᵈ " => DijkstraMonad.dBind

/-- Mapping a function over a Dijkstra-monad computation, specified by the map of its
specification. -/
def DijkstraMonad.dMap {w d} [Monad w] [DijkstraMonad w d] {α β} {a : w α} (f : α → β) :
    d a → d (a >>= fun b => pure (f b)) := fun x => x >>=ᵈ (fun a => dPure (f a))

export DijkstraMonad (dMap)

@[inherit_doc] infixr:100 " <$>ᵈ " => DijkstraMonad.dMap

/-- The laws of a Dijkstra monad, each transported along the corresponding monad law of its
specifications. -/
class LawfulDijkstraMonad (w : Type u → Type v) (d : {α : Type u} → w α → Type z) [Monad w]
    [LawfulMonad w] [DijkstraMonad w d] where
  dPure_dBind {α β} {f : α → w β} (x : α) (g : (a : α) → d (f a)) :
    (pure_bind x f) ▸ (dPure x >>=ᵈ g) = g x
  dBind_dPure {α} {a : w α} (x : d a) :
    (bind_pure a) ▸ (x >>=ᵈ dPure) = x
  dBind_assoc {α β γ} {a} {f : α → w β} {g : β → w γ} (x : d a)
    (f' : (a : α) → d (f a)) (g' : (b : β) → d (g b)) :
      (bind_assoc a f g) ▸ ((x >>=ᵈ f') >>=ᵈ g') = x >>=ᵈ (fun a => f' a >>=ᵈ g')

export LawfulDijkstraMonad (dPure_dBind dBind_dPure dBind_assoc)

attribute [simp] dPure_dBind dBind_dPure dBind_assoc

/-- A Dijkstra monad over an ordered specification monad, with a weakening of every computation
to any weaker specification that respects identities, composites and `dBind`. -/
class OrderedDijkstraMonad (w : Type u → Type v) (d : {α : Type u} → w α → Type z)
    [OrderedMonad w] extends DijkstraMonad w d where
  /-- Weaken a computation to a weaker specification. -/
  dWeaken {α} {wa wa' : w α} : d wa → (wa ≤ₘ wa') → d wa'
  dWeaken_refl {α} {wa : w α} (x : d wa) : dWeaken x (le_refl _) = x
  dWeaken_trans {α} {wa wa' wa'' : w α} (x : d wa) (h1 : wa ≤ₘ wa') (h2 : wa' ≤ₘ wa'') :
    dWeaken (dWeaken x h1) h2 = dWeaken x (le_trans h1 h2)
  dWeaken_dBind {α β} {wa wa' : w α} {f f' : α → w β} (x : d wa) (g : (a : α) → d (f a))
    (ha : wa ≤ₘ wa') (hf : ∀ a, f a ≤ₘ f' a) :
      (dWeaken x ha) >>=ᵈ (fun a => dWeaken (g a) (hf a)) = dWeaken (x >>=ᵈ g) (bind_mono ha hf)

export OrderedDijkstraMonad (dWeaken dWeaken_refl dWeaken_trans dWeaken_dBind)

attribute [simp] dWeaken_refl dWeaken_trans dWeaken_dBind

namespace DijkstraMonad

/-- Dependent branching, specified by the branching of the specifications. -/
def dDite {w : Type u → Type v} {d : {α : Type u} → w α → Type z} {α} (c : Prop)
    [h : Decidable c] {t : c → w α}
    {e : ¬c → w α} : ((c' : c) → d (t c')) → ((c' : ¬c) → d (e c')) → d (dite c t e) :=
  fun dt de => match h with
    | isTrue hc => dt hc
    | isFalse hc => de hc

/-- Branching, specified by the branching of the specifications. -/
def dIte {w : Type u → Type v} {d : {α : Type u} → w α → Type z} {α} (c : Prop) [Decidable c]
    {t e : w α} :
    d t → d e → d (ite c t e) :=
  fun dt de => dDite c (fun _ => dt) (fun _ => de)

end DijkstraMonad

/-- A map of Dijkstra monads along a monad lift of their specifications. -/
class DijkstraMonadMorphism (w₁ : Type u → Type v) (w₂ : Type u → Type w)
    (d₁ : {α : Type u} → w₁ α → Type z) (d₂ : {α : Type u} → w₂ α → Type z)
    [Monad w₁] [Monad w₂] [MonadLiftT w₁ w₂] [DijkstraMonad w₁ d₁] [DijkstraMonad w₂ d₂] where
  /-- Map a computation to one specified by the lifted specification. -/
  dMorphism {α : Type u} {a : w₁ α} : d₁ a → d₂ (monadLift a)

export DijkstraMonadMorphism (dMorphism)

/-- A Dijkstra monad morphism that preserves `dPure` and `dBind`, up to the laws of the lawful
lift of the specifications. -/
class LawfulDijkstraMonadLift (w₁ : Type u → Type v) (w₂ : Type u → Type w)
    (d₁ : {α : Type u} → w₁ α → Type z) (d₂ : {α : Type u} → w₂ α → Type z)
    [Monad w₁] [Monad w₂] [MonadLiftT w₁ w₂] [DijkstraMonad w₁ d₁] [DijkstraMonad w₂ d₂]
    [inst : DijkstraMonadMorphism w₁ w₂ d₁ d₂]
    [LawfulMonad w₁] [LawfulMonad w₂] [LawfulMonadLiftT w₁ w₂] where
  dMorphism_dPure {α : Type u} (a : α) :
    (monadLift_pure (m := w₁) (n := w₂) a) ▸ (dMorphism (dPure a : d₁ _)) = (dPure a : d₂ _)
  dMorphism_dBind {α β : Type u} {a : w₁ α} {f : α → w₁ β} (x : d₁ a) (g : (a : α) → d₁ (f a)) :
    (monadLift_bind (m := w₁) (n := w₂) a f) ▸ (dMorphism x >>=ᵈ (fun a => dMorphism (g a))) =
      inst.dMorphism (x >>=ᵈ g)

export LawfulDijkstraMonadLift (dMorphism_dPure dMorphism_dBind)

attribute [simp] dMorphism_dPure dMorphism_dBind

namespace DijkstraMonad

/-! ## Dijkstra monads from monad relations, and monads from Dijkstra monads -/

variable {m : Type u → Type v} {n : Type u → Type w}

/-- A lawful monad relation between `m` and `n` presents a Dijkstra monad over `n`: its
computations at `na` are the `m`-computations related to `na`. -/
instance instOfMonadRelation {m n} [Monad m] [Monad n] [MonadRelation m n]
    [LawfulMonadRelation m n] : DijkstraMonad n (fun na => { ma : m _ // monadRel ma na}) where
  dPure x := ⟨pure x, monadRel_pure x⟩
  dBind x f := ⟨x.1 >>= (fun a => (f a).1), monadRel_bind x.2 (fun a => (f a).2)⟩

/-- A lawful monad lift presents a Dijkstra monad over its target: its computations at `na` are
the computations whose lift is `na`. -/
instance instOfMonadMorphism {m n} [Monad m] [Monad n] [h : MonadLiftT m n]
    [h' : LawfulMonadLiftT m n] :
      DijkstraMonad n (fun na => { ma : m _ // monadLift ma = na }) :=
  @instOfMonadRelation m n _ _ (@MonadRelation.instOfMonadLiftT m n h)
    (@MonadRelation.instOfLawfulMonadLiftT m n _ _ h h')

/-- A Dijkstra monad `d` on a monad `w` can be seen as a monad on the dependent pair `(w, d)`. -/
instance instMonadSigma {w d} [Monad w] [DijkstraMonad w d] :
    Monad (fun α => (w : w α) × d w) where
  pure x := ⟨pure x, dPure x⟩
  bind x f := ⟨x.1 >>= (fun a => (f a).1), x.2 >>=ᵈ (fun a => (f a).2)⟩

/-- The first projection lifts a pair of a specification and a computation to the specification
monad. -/
instance {w : Type u → Type v} {d : {α : Type u} → w α → Type z} :
    MonadLiftT (fun α => (w : w α) × d w) w where
  monadLift x := x.1

/-- The graph of the first projection relates a pair to its specification. -/
instance {w : Type u → Type v} {d : {α : Type u} → w α → Type z} :
    MonadRelation (fun α => (w : w α) × d w) w :=
  MonadRelation.instOfMonadLiftT

end DijkstraMonad

/-! ## The free Dijkstra monad -/

/-- Computations generated by `pure` and the binds of `m`, indexed by the specification they spell:
a computation at `pure x` returns `x`, and a computation at `x >>= f` runs the specification-level
computation `x` and continues, at each result `a`, with a computation at `f a`. -/
inductive FreeDijkstra (m : Type u → Type v) [Monad m] : {α : Type u} → m α → Type (max (u + 1) v)
  /-- The computation returning `x`. -/
  | protected pure {α} (x : α) : FreeDijkstra m (pure x)
  /-- Run `x` and continue with `r a` at its result `a`. -/
  | roll {α β} (x : m α) {f : α → m β} (r : (a : α) → FreeDijkstra m (f a)) :
      FreeDijkstra m (x >>= f)

namespace FreeDijkstra

variable {m : Type u → Type v} [Monad m] [LawfulMonad m]

/-- Sequencing of free Dijkstra computations: the continuation is grafted at every `pure`, with the
specification transported along `pure_bind` and `bind_assoc`. -/
def bind {β : Type u} : {α : Type u} → {wa : m α} → {wb : α → m β} → FreeDijkstra m wa →
    ((a : α) → FreeDijkstra m (wb a)) → FreeDijkstra m (wa >>= wb)
  | _, _, wb, .pure x, k => (pure_bind x wb).symm ▸ k x
  | _, _, wb, .roll x (f := f) r, k => (bind_assoc x f wb).symm ▸ .roll x fun a => bind (r a) k

/-- Free Dijkstra computations form a Dijkstra monad over a lawful specification monad. -/
instance instDijkstraMonad : DijkstraMonad m (FreeDijkstra m) where
  dPure := FreeDijkstra.pure
  dBind := FreeDijkstra.bind

end FreeDijkstra
