/-!
# Free monads modulo an equational theory

An equational theory `T` over a polynomial functor `P` is a family of pairs of terms of
`P.FreeM`, each pair in its own context (the return type of the two terms is the type of
variables). The congruence `T.Cong` it generates on `P.FreeM α` is closed under substitution
into the equations of `T`, under the constructor `liftBind` and under `FreeM.bind`. The quotient
`QFreeM T α` is a lawful monad, and it is the free model of `T`: a handler of `P` into a lawful
monad `M` that validates the equations of `T` factors uniquely through the quotient.

A quotient container of Abbott, Altenkirch, Ghani and McBride [AAGM04] is
a polynomial functor with a group of permutations of the directions at each position; its
extension identifies a family `f` with `f ∘ g` for each symmetry `g`. Its symmetries form an
equational theory `Q.theory`, and `QFreeM Q.theory α` is the initial algebra of
`X ↦ α ⊕ ⟦Q⟧ X`, that is, the free monad of the quotient container.

## Main definitions

* `PFunctor.EqTheory` — an equational theory over a polynomial functor
* `PFunctor.EqTheory.Cong` — the congruence generated by a theory
* `PFunctor.QFreeM` — the free monad modulo a theory, with its `Monad` and `LawfulMonad`
* `PFunctor.EqTheory.Validates` — a handler validates the equations of a theory
* `PFunctor.QFreeM.lift` — the interpretation of the quotient through a validating handler
* `PFunctor.QContainer` — a quotient container, its extension `Obj` and its `theory`
* `PFunctor.QContainer.alg`, `PFunctor.QContainer.fold` — the algebra structure of the quotient
  and the fold into an algebra

## Main results

* `PFunctor.EqTheory.Cong.bind` — the congruence is closed under bind
* `PFunctor.QFreeM.instLawfulMonad` — the quotient is a lawful monad
* `PFunctor.QFreeM.lift_mk`, `PFunctor.QFreeM.isMonadHom_lift`, `PFunctor.QFreeM.lift_op` — the
  interpretation extends the handler and is a monad morphism
* `PFunctor.QFreeM.lift_unique` — uniqueness of the interpretation
* `PFunctor.QFreeM.op_validates` — the generic operations of the quotient validate the theory
* `PFunctor.QContainer.fold_pure`, `PFunctor.QContainer.fold_alg`,
  `PFunctor.QContainer.fold_unique` — the quotient by the symmetries is the initial algebra of
  `X ↦ α ⊕ ⟦Q⟧ X`

## References

Abbott, Altenkirch, Ghani and McBride [AAGM04]; see `REFERENCES.md`.
-/

@[expose] public section

universe uA uB v w x

namespace PFunctor

/-! ## Equational theories and their congruence -/

/-- An equational theory over `P`: equations indexed by `Eqn`, each a pair of terms of
`P.FreeM` in the context `ctx e` (the type of variables). -/
structure EqTheory (P : PFunctor.{uA, uB}) where
  /-- The index type of the equations. -/
  Eqn : Type w
  /-- The context of an equation: the type of its variables. -/
  ctx : Eqn → Type uB
  /-- The left-hand side of an equation. -/
  lhs : (e : Eqn) → P.FreeM (ctx e)
  /-- The right-hand side of an equation. -/
  rhs : (e : Eqn) → P.FreeM (ctx e)

namespace EqTheory

variable {P : PFunctor.{uA, uB}} (T : EqTheory.{uA, uB, w} P)

/-- The congruence on `P.FreeM α` generated by `T`: the equations of `T` under every
substitution, closed under equivalence and under `liftBind`. -/
inductive Cong {α : Type v} : P.FreeM α → P.FreeM α → Prop
  /-- An equation of `T` under the substitution `σ` of its variables. -/
  | ax (e : T.Eqn) (σ : T.ctx e → P.FreeM α) : Cong ((T.lhs e).bind σ) ((T.rhs e).bind σ)
  /-- Reflexivity. -/
  | refl (x : P.FreeM α) : Cong x x
  /-- Symmetry. -/
  | symm {x y : P.FreeM α} : Cong x y → Cong y x
  /-- Transitivity. -/
  | trans {x y z : P.FreeM α} : Cong x y → Cong y z → Cong x z
  /-- Congruence for the constructor `liftBind`. -/
  | liftBind (a : P.A) {k k' : P.B a → P.FreeM α} :
      (∀ u, Cong (k u) (k' u)) → Cong (.liftBind a k) (.liftBind a k')

variable {T}

/-- The congruence is closed under bind in the continuation. -/
theorem Cong.bind_right {α : Type v} {β : Type x} (y : P.FreeM α) {f f' : α → P.FreeM β}
    (h : ∀ a, T.Cong (f a) (f' a)) : T.Cong (y.bind f) (y.bind f') := by
  induction y using FreeM.rec with
  | pure a => exact h a
  | liftBind a k ih => exact Cong.liftBind a ih

/-- The congruence is closed under bind in the bound term. -/
theorem Cong.bind_left {α : Type v} {β : Type x} {y y' : P.FreeM α} (h : T.Cong y y')
    (f : α → P.FreeM β) : T.Cong (y.bind f) (y'.bind f) := by
  induction h with
  | ax e σ => rw [FreeM.bind_assoc, FreeM.bind_assoc]; exact .ax e _
  | refl y => exact .refl _
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | liftBind a _ ih => exact .liftBind a ih

/-- The congruence is closed under bind. -/
theorem Cong.bind {α : Type v} {β : Type x} {y y' : P.FreeM α} {f f' : α → P.FreeM β}
    (hy : T.Cong y y') (hf : ∀ a, T.Cong (f a) (f' a)) : T.Cong (y.bind f) (y'.bind f') :=
  (hy.bind_left f).trans (Cong.bind_right y' hf)

variable (T)

/-- The setoid of the congruence generated by `T`. -/
def setoid (α : Type v) : Setoid (P.FreeM α) where
  r := T.Cong
  iseqv := ⟨Cong.refl, Cong.symm, Cong.trans⟩

end EqTheory

/-! ## The quotient monad -/

/-- The free monad over `P` modulo the equational theory `T`. -/
def QFreeM {P : PFunctor.{uA, uB}} (T : EqTheory.{uA, uB, w} P) (α : Type v) :
    Type (max uA uB v) :=
  Quotient (T.setoid α)

namespace QFreeM

variable {P : PFunctor.{uA, uB}} {T : EqTheory.{uA, uB, w} P}

/-- The class of a term. -/
def mk {α : Type v} (y : P.FreeM α) : QFreeM T α := Quotient.mk _ y

/-- Congruent terms have the same class. -/
theorem sound {α : Type v} {y y' : P.FreeM α} (h : T.Cong y y') :
    (mk y : QFreeM T α) = mk y' :=
  Quotient.sound h

/-- A representative of a class is congruent to each term of the class. -/
theorem out_mk_cong {α : Type v} (y : P.FreeM α) : T.Cong (mk y : QFreeM T α).out y :=
  Quotient.mk_out (s := T.setoid α) y

/-- Every class is the class of a term. -/
theorem exists_mk {α : Type v} (q : QFreeM T α) : ∃ y, mk y = q :=
  Quotient.exists_rep q

/-- Every family of classes is the family of classes of a family of terms. -/
theorem exists_mk_fun {α : Type v} {β : Type x} (f : α → QFreeM T β) :
    ∃ g : α → P.FreeM β, f = fun a => mk (g a) :=
  ⟨fun a => (f a).out, funext fun a => (Quotient.out_eq (f a)).symm⟩

/-- `pure` on the quotient. -/
def pure {α : Type v} (a : α) : QFreeM T α := mk (.pure a)

/-- `bind` on the quotient: bind a representative into representatives of the continuation. -/
noncomputable def bind {α : Type v} {β : Type x} (q : QFreeM T α) (f : α → QFreeM T β) :
    QFreeM T β :=
  Quotient.liftOn q (fun y => mk (y.bind fun a => (f a).out))
    (fun _ _ h => sound (EqTheory.Cong.bind_left h _))

/-- `bind` of classes is the class of `bind`. -/
theorem bind_mk_mk {α : Type v} {β : Type x} (y : P.FreeM α) (g : α → P.FreeM β) :
    bind (mk y : QFreeM T α) (fun a => mk (g a)) = mk (y.bind g) :=
  sound (EqTheory.Cong.bind_right y fun a => out_mk_cong (g a))

/-- The generic operation `a` in the quotient. -/
def op (a : P.A) : QFreeM T (P.B a) := mk (FreeM.lift a)

/-- The quotient is a monad. -/
noncomputable instance instMonad : Monad (QFreeM.{uA, uB, v, w} T) where
  pure := QFreeM.pure
  bind := QFreeM.bind

/-- Left unit law of the quotient. -/
theorem pure_bind' {α β : Type v} (a : α) (f : α → QFreeM T β) : bind (pure a) f = f a :=
  Quotient.out_eq (f a)

/-- Right unit law of the quotient. -/
theorem bind_pure' {α : Type v} (q : QFreeM T α) : bind q (fun a => pure a) = q :=
  Quotient.inductionOn q fun y => by
    change bind (mk y) (fun a => mk (.pure a)) = mk y
    rw [bind_mk_mk]
    exact congrArg mk (FreeM.bind_pure y)

/-- Associativity of the quotient's bind. -/
theorem bind_assoc' {α β γ : Type v} (q : QFreeM T α) (f : α → QFreeM T β)
    (g : β → QFreeM T γ) : bind (bind q f) g = bind q (fun a => bind (f a) g) := by
  obtain ⟨y, rfl⟩ := exists_mk q
  obtain ⟨F, rfl⟩ := exists_mk_fun f
  obtain ⟨G, rfl⟩ := exists_mk_fun g
  simp only [bind_mk_mk, FreeM.bind_assoc]

/-- The quotient is a lawful monad. -/
noncomputable instance instLawfulMonad : LawfulMonad (QFreeM.{uA, uB, v, w} T) :=
  LawfulMonad.mk' (id_map := fun q => bind_pure' q) (pure_bind := fun a f => pure_bind' a f)
    (bind_assoc := fun q f g => bind_assoc' q f g)

end QFreeM

/-! ## The free model: interpretation through a validating handler -/

namespace EqTheory

variable {P : PFunctor.{uA, uB}} (T : EqTheory.{uA, uB, w} P)

/-- A handler of `P` into `M` validates `T`: the two sides of each equation interpret to the
same computation. -/
def Validates {M : Type uB → Type v} [Monad M] (h : (a : P.A) → M (P.B a)) : Prop :=
  ∀ e, (T.lhs e).liftM h = (T.rhs e).liftM h

variable {T}

/-- The interpretation through a validating handler respects the congruence. -/
theorem liftM_eq_of_cong {M : Type uB → Type v} [Monad M] [LawfulMonad M]
    {h : (a : P.A) → M (P.B a)} (hT : T.Validates h) {α : Type uB} {y y' : P.FreeM α}
    (hy : T.Cong y y') : y.liftM h = y'.liftM h := by
  induction hy with
  | ax e σ =>
    have h₁ := FreeM.liftM_bind (interp := h) (T.lhs e) σ
    have h₂ := FreeM.liftM_bind (interp := h) (T.rhs e) σ
    rw [hT e] at h₁
    exact h₁.trans h₂.symm
  | refl => rfl
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | liftBind a _ ih => simp only [FreeM.liftM, ih]

end EqTheory

namespace QFreeM

variable {P : PFunctor.{uA, uB}} {T : EqTheory.{uA, uB, w} P}
variable {M : Type uB → Type v} [Monad M] [LawfulMonad M]

/-- The interpretation of the quotient through a handler that validates `T`. -/
def lift (h : (a : P.A) → M (P.B a)) (hT : T.Validates h) {α : Type uB} (q : QFreeM T α) :
    M α :=
  Quotient.liftOn q (·.liftM h) fun _ _ hy => EqTheory.liftM_eq_of_cong hT hy

variable (h : (a : P.A) → M (P.B a)) (hT : T.Validates h)

/-- On a class, the interpretation is `liftM` of a representative. -/
@[simp] theorem lift_mk {α : Type uB} (y : P.FreeM α) : lift h hT (mk y) = y.liftM h := rfl

/-- The interpretation of a generic operation is the handler. -/
@[simp] theorem lift_op (a : P.A) : lift h hT (op a : QFreeM T (P.B a)) = h a :=
  FreeM.liftM_lift h a

/-- The interpretation is a monad morphism. -/
theorem isMonadHom_lift :
    Cslib.IsMonadHom (QFreeM.{uA, uB, uB, w} T) M (fun q => lift h hT q) := by
  refine Cslib.IsMonadHom.mk' (fun a => rfl) fun q f => ?_
  obtain ⟨y, rfl⟩ := exists_mk q
  obtain ⟨F, rfl⟩ := exists_mk_fun f
  change lift h hT (bind (mk y) fun a => mk (F a)) = _
  rw [bind_mk_mk, lift_mk]
  exact FreeM.liftM_bind (interp := h) y F

/-- Uniqueness: a map on the quotient whose composite with the class map interprets `h` is the
interpretation. -/
theorem lift_unique {α : Type uB} (eval : QFreeM T α → M α)
    (he : FreeM.Interprets h fun y => eval (mk y)) : eval = lift h hT :=
  funext fun q => Quotient.inductionOn q fun y => congrFun he.eq y

/-- In the quotient, interpreting a term by the generic operations gives its class. -/
theorem liftM_op {α : Type uB} (y : P.FreeM α) :
    y.liftM (m := QFreeM.{uA, uB, uB, w} T) (fun a => (op a : QFreeM T (P.B a))) = mk y := by
  induction y using FreeM.rec with
  | pure a => rfl
  | liftBind a k ih =>
    change bind (op a) (fun u => (k u).liftM fun a => (op a : QFreeM T (P.B a))) = _
    simp only [ih]
    exact bind_mk_mk _ _

/-- The generic operations of the quotient validate `T`: the quotient is a model of `T`. -/
theorem op_validates :
    T.Validates (M := QFreeM.{uA, uB, uB, w} T) fun a => (op a : QFreeM T (P.B a)) := by
  intro e
  rw [liftM_op, liftM_op]
  exact (congrArg mk (FreeM.bind_pure (T.lhs e))).symm.trans
    ((sound (EqTheory.Cong.ax (T := T) e FreeM.pure)).trans
      (congrArg mk (FreeM.bind_pure (T.rhs e))))

end QFreeM

/-! ## Quotient containers -/

/-- A quotient container: a polynomial functor with a group of symmetries of the directions at
each position [AAGM04]. -/
structure QContainer where
  /-- The underlying polynomial functor. -/
  P : PFunctor.{uA, uB}
  /-- The symmetries of the directions at a position. -/
  G : (a : P.A) → Subgroup (Equiv.Perm (P.B a))

namespace QContainer

variable (Q : QContainer.{uA, uB})

/-- Two families of directions are related when one is the other composed with a symmetry. -/
def SymRel {X : Type v} (a : Q.P.A) (f f' : Q.P.B a → X) : Prop :=
  ∃ g ∈ Q.G a, f' = f ∘ g

/-- The extension of a quotient container: a position and a family of directions up to
symmetry. -/
def Obj (X : Type v) : Type (max uA uB v) :=
  Σ a : Q.P.A, Quot (Q.SymRel (X := X) a)

/-- The action of the extension on maps. -/
def map {X : Type v} {Y : Type w} (φ : X → Y) : Q.Obj X → Q.Obj Y
  | ⟨a, q⟩ => ⟨a, Quot.map (φ ∘ ·) (fun _ _ ⟨g, hg, hf⟩ => ⟨g, hg, by rw [hf]; rfl⟩) q⟩

/-- The extension preserves identities. -/
theorem map_id {X : Type v} (o : Q.Obj X) : Q.map id o = o := by
  obtain ⟨a, q⟩ := o
  induction q using Quot.ind
  rfl

/-- The extension preserves composition. -/
theorem map_comp {X : Type v} {Y : Type w} {Z : Type x} (φ : X → Y) (ψ : Y → Z) (o : Q.Obj X) :
    Q.map (ψ ∘ φ) o = Q.map ψ (Q.map φ o) := by
  obtain ⟨a, q⟩ := o
  induction q using Quot.ind
  rfl

/-- The symmetries as an equational theory: the operation `a` followed by the variables is
equal to `a` followed by the variables permuted by `g ∈ G a`. -/
def theory : EqTheory.{uA, uB, max uA uB} Q.P where
  Eqn := Σ a : Q.P.A, Q.G a
  ctx e := Q.P.B e.1
  lhs e := FreeM.lift e.1
  rhs e := FreeM.liftBind e.1 fun u => FreeM.pure ((e.2 : Equiv.Perm (Q.P.B e.1)) u)

/-- The algebra structure of the quotient: a position and a family of classes up to symmetry
give the class of the operation followed by the family. -/
noncomputable def alg {α : Type v} : Q.Obj (QFreeM Q.theory α) → QFreeM Q.theory α
  | ⟨a, q⟩ => Quot.lift (fun f => QFreeM.mk (.liftBind a fun u => (f u).out))
      (by
        rintro f _ ⟨g, hg, rfl⟩
        exact QFreeM.sound (EqTheory.Cong.ax (T := Q.theory) ⟨a, g, hg⟩ fun u => (f u).out))
      q

/-- The algebra structure on a family of classes. -/
theorem alg_mk {α : Type v} (a : Q.P.A) (k : Q.P.B a → Q.P.FreeM α) :
    Q.alg (⟨a, Quot.mk _ fun u => QFreeM.mk (k u)⟩ : Q.Obj (QFreeM Q.theory α)) =
      QFreeM.mk (.liftBind a k) :=
  QFreeM.sound (EqTheory.Cong.liftBind a fun u => QFreeM.out_mk_cong (k u))

variable {Q}

/-- The fold of a tree into an algebra `(X, η, φ)` of `X ↦ α ⊕ ⟦Q⟧ X`. -/
def foldTree {α : Type v} {X : Type w} (η : α → X) (φ : Q.Obj X → X) : Q.P.FreeM α → X
  | .pure a => η a
  | .liftBind a k => φ ⟨a, Quot.mk _ fun u => foldTree η φ (k u)⟩

/-- The fold respects the congruence of the symmetries. -/
theorem foldTree_eq_of_cong {α : Type v} {X : Type w} (η : α → X) (φ : Q.Obj X → X)
    {y y' : Q.P.FreeM α} (hy : Q.theory.Cong y y') : foldTree η φ y = foldTree η φ y' := by
  induction hy with
  | ax e σ =>
    obtain ⟨a, g, hg⟩ := e
    exact congrArg (fun q => φ ⟨a, q⟩) (Quot.sound ⟨g, hg, rfl⟩)
  | refl => rfl
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  | liftBind a _ ih => exact congrArg (fun q => φ ⟨a, q⟩) (congrArg (Quot.mk _) (funext ih))

/-- The fold of the quotient into an algebra `(X, η, φ)` of `X ↦ α ⊕ ⟦Q⟧ X`. -/
def fold {α : Type v} {X : Type w} (η : α → X) (φ : Q.Obj X → X) : QFreeM Q.theory α → X :=
  fun q => Quotient.liftOn q (foldTree η φ) fun _ _ hy => foldTree_eq_of_cong η φ hy

/-- The fold is a morphism of algebras on the unit. -/
@[simp] theorem fold_pure {α : Type v} {X : Type w} (η : α → X) (φ : Q.Obj X → X) (a : α) :
    fold η φ (QFreeM.pure a : QFreeM Q.theory α) = η a := rfl

/-- The fold is a morphism of algebras on the operations. -/
theorem fold_alg {α : Type v} {X : Type w} (η : α → X) (φ : Q.Obj X → X)
    (o : Q.Obj (QFreeM Q.theory α)) : fold η φ (Q.alg o) = φ (Q.map (fold η φ) o) := by
  obtain ⟨a, q⟩ := o
  induction q using Quot.ind with | mk f => ?_
  obtain ⟨F, rfl⟩ := QFreeM.exists_mk_fun f
  rw [alg_mk]
  rfl

/-- The fold is the unique morphism of algebras: the quotient by the symmetries is the initial
algebra of `X ↦ α ⊕ ⟦Q⟧ X`, the free monad of the quotient container at `α`. -/
theorem fold_unique {α : Type v} {X : Type w} (η : α → X) (φ : Q.Obj X → X)
    (u : QFreeM Q.theory α → X) (hu₁ : ∀ a, u (QFreeM.pure a) = η a)
    (hu₂ : ∀ o, u (Q.alg o) = φ (Q.map u o)) : u = fold η φ := by
  funext q
  obtain ⟨y, rfl⟩ := QFreeM.exists_mk q
  induction y using FreeM.rec with
  | pure a => exact hu₁ a
  | liftBind a k ih =>
    rw [← alg_mk]
    refine (hu₂ _).trans ((congrArg φ ?_).trans (fold_alg η φ _).symm)
    change (⟨a, Quot.mk _ fun v => u (QFreeM.mk (k v))⟩ : Q.Obj X) =
      ⟨a, Quot.mk _ fun v => fold η φ (QFreeM.mk (k v))⟩
    simp only [ih]

end QContainer

end PFunctor

end
